# @envFlag=APP_ENV @defaultSensitive=false @defaultRequired=infer @generateTypes(lang='ts', path='env.d.ts')
# ---
# Shared monorepo env vars. Imported by each app's .env.schema.

# Environment envelope
# @type=enum(development, test, staging, production)
APP_ENV=development

# Log level for server log handler
# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
