{
  "$schema": "https://json.schemastore.org/package",
  "name": "@oh/shared",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Oskar Hulter <oskarhulter@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarHulter/oh-monorepo.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "clean": "rimraf dist",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "rimraf": "catalog:",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
  }
}
