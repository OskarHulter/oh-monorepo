{
  "$schema": "https://json.schemastore.org/package",
  "name": "@oh/client",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Oskar Hulter <oskarhulter@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarHulter/oh-monorepo.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./ui/styles.css": "./src/ui/styles.css",
    "./adapters/fixture": {
      "types": "./src/adapters/fixture/index.tsx",
      "import": "./src/adapters/fixture/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.mjs"
      },
      "./ui/styles.css": "./dist/ui/styles.css",
      "./adapters/fixture": {
        "types": "./dist/adapters/fixture/index.d.ts",
        "import": "./dist/adapters/fixture/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "clean": "rimraf dist",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@oh/shared": "workspace:*",
    "@oh/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
